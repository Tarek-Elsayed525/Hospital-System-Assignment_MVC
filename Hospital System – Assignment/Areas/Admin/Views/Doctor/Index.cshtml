@model IEnumerable<Hospital_System___Assignment.Models.Doctor>

@{
    ViewData["Title"] = "Manage Doctors";
}

<div class="container-fluid py-4">
    <!-- Header & Add Button -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark m-0"><i class="bi bi-people-fill text-primary me-2"></i>Manage Doctors</h2>
            <p class="text-muted small m-0">View, search, and manage all hospital doctors efficiently.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 shadow-sm rounded-pill fw-semibold">
            <i class="bi bi-plus-lg me-1"></i> Add New Doctor
        </a>
    </div>

    <!-- Search Bar Card -->
    <div class="card border-0 shadow-sm mb-4 rounded-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted ps-3"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchName" value="@ViewBag.SearchName" class="form-control border-start-0 ps-0 shadow-none" placeholder="Search doctor by name..." />
                    </div>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary fw-semibold rounded-pill flex-grow-1">Search</button>
                    <a asp-action="Index" class="btn btn-outline-secondary fw-semibold rounded-pill px-3 d-flex align-items-center justify-content-center gap-1" title="Reset Search">
                        <i class="bi bi-arrow-clockwise"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Doctors Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-secondary">
                        <tr>
                            <th class="py-3 ps-4">Doctor Name</th>
                            <th class="py-3">Specialization</th>
                            <th class="py-3 text-center" style="width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var doctor in Model)
                            {
                                <tr>
                                    <!-- اسم الدكتور والصورة المصغرة -->
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@Url.Content("~/assets/img/doctors/" + doctor.DoctorImage)"
                                                 alt="@doctor.DoctorName"
                                                 class="rounded-circle shadow-sm border"
                                                 style="width: 45px; height: 45px; object-fit: cover;"
                                                 onerror="this.src='~/assets/img/doctors/default.jpg'" />
                                            <div>
                                                <h6 class="mb-0 fw-bold text-dark">@doctor.DoctorName</h6>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- التخصص -->
                                    <td>
                                        <span class="badge bg-light text-primary border px-3 py-2 rounded-pill fw-medium">
                                            @doctor.Specialization
                                        </span>
                                    </td>

                                    <!-- أزرار الـ CRUD (Update & Delete باستخدام Form صحيح للـ SweetAlert) -->
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-action="Update" asp-route-id="@doctor.DoctorId" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-semibold">
                                                <i class="bi bi-pencil-square me-1"></i> Update
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@doctor.DoctorId" method="post" class="d-inline delete-form">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold">
                                                    <i class="bi bi-trash me-1"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    No doctors found matching your search.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination Footer -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link rounded-circle mx-1 @(i == ViewBag.CurrentPage ? "bg-primary text-white border-primary" : "text-dark")"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-searchName="@ViewBag.SearchName"
                                   style="width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; font-weight: 600;">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Success Alert (Create - أخضر) -->
@if (TempData["Success"] != null)
{
    <div id="success-alert" class="alert shadow-lg position-fixed top-0 end-0 m-4 p-3 border-0 text-white fw-bold"
         style="background-color: #198754; z-index: 1080; min-width: 300px; border-radius: 8px;">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <i class="fas fa-check-circle me-2 fa-lg"></i>
                <span>@TempData["Success"]</span>
            </div>
            <button type="button" class="btn-close btn-close-white ms-3" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<!-- Update Alert (Update - أصفر) -->
@if (TempData["Update"] != null)
{
    <div id="update-alert" class="alert shadow-lg position-fixed top-0 end-0 m-4 p-3 border-0 text-dark fw-bold"
         style="background-color: #ffc107; z-index: 1080; min-width: 300px; border-radius: 8px;">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <i class="fas fa-edit me-2 fa-lg"></i>
                <span>@TempData["Update"]</span>
            </div>
            <button type="button" class="btn-close ms-3" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@section Scripts {
    <script>
        // إخفاء رسالة الإضافة تلقائياً بعد 3 ثواني
        setTimeout(function () {
            var successAlert = document.getElementById('success-alert');
            if (successAlert) {
                var bsAlert = new bootstrap.Alert(successAlert);
                bsAlert.close();
            }
        }, 3000);

        // إخفاء رسالة التعديل تلقائياً بعد 3 ثواني
        setTimeout(function () {
            var updateAlert = document.getElementById('update-alert');
            if (updateAlert) {
                var bsUpdateAlert = new bootstrap.Alert(updateAlert);
                bsUpdateAlert.close();
            }
        }, 3000);
    </script>

    <script>
        // تفعيل SweetAlert2 لجميع أزرار وحذف الأطباء
        document.querySelectorAll('.delete-form').forEach(form => {
            form.addEventListener('submit', function (e) {
                e.preventDefault(); // إيقاف إرسال الفورم مؤقتاً

                Swal.fire({
                    title: "Are you sure?",
                    text: "You won't be able to revert this!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit(); // إرسال الفورم فعلياً عند الموافقة
                    }
                });
            });
        });
    </script>
}