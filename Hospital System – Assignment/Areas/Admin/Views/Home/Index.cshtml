@{
    ViewData["Title"] = "Home Page";
}

<style>
    .hero-custom {
        position: relative;
        background: url('/assets/img/hero-bg.jpg') no-repeat center center;
        background-size: cover;
        min-height: calc(100vh - 80px);
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #fff;
        margin: 0;
    }

        .hero-custom::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.25);
            z-index: 1;
        }

    .hero-content-box {
        position: relative;
        z-index: 2;
        background: rgba(0, 0, 0, 0.5);
        padding: 50px 60px;
        border-radius: 8px;
        max-width: 850px;
        width: 90%;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(2px);
    }

        .hero-content-box h2 {
            font-size: 2.8rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 15px;
            letter-spacing: 0.5px;
        }

        .hero-content-box p {
            font-size: 1.15rem;
            color: #f1f1f1;
            margin-bottom: 0;
        }
</style>

<section class="hero-custom">
    <div class="hero-content-box">
        <h2>Welcome to Hospital System</h2>
        <p>Efficiently manage doctors, patients, and appointments</p>
    </div>
</section>