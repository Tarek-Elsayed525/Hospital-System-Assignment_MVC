@model Hospital_System___Assignment.Models.BookAppointment

@{
    ViewData["Title"] = "Update Appointment";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Card Header -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-warning text-dark py-3 px-4 d-flex align-items-center justify-content-between">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Update Appointment</h5>
                    <a asp-action="Index" class="btn btn-light btn-sm rounded-pill fw-semibold px-3 text-dark">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Update" method="post" class="needs-validation" novalidate>
                        <!-- الحقل المخفي للـ Id لضمان نجاح التحديث المباشر -->
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

                        <!-- اسم المريض -->
                        <div class="mb-3">
                            <label asp-for="PatientName" class="form-label fw-semibold text-secondary">Patient Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                <input asp-for="PatientName" class="form-control border-start-0 shadow-none" placeholder="Enter patient full name..." />
                            </div>
                            <span asp-validation-for="PatientName" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="row">
                            <!-- تاريخ الحجز -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="AppointmentDate" class="form-label fw-semibold text-secondary">Appointment Date</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-calendar-event"></i></span>
                                    <input asp-for="AppointmentDate" type="date" class="form-control border-start-0 shadow-none" />
                                </div>
                                <span asp-validation-for="AppointmentDate" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- وقت الحجز -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="AppointmentTime" class="form-label fw-semibold text-secondary">Appointment Time</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-clock"></i></span>
                                    <input asp-for="AppointmentTime" type="time" class="form-control border-start-0 shadow-none" />
                                </div>
                                <span asp-validation-for="AppointmentTime" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- اختيار الدكتور من القائمة -->
                        <div class="mb-4">
                            <label asp-for="DoctorId" class="form-label fw-semibold text-secondary">Select Doctor</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person-badge"></i></span>
                                <select asp-for="DoctorId" class="form-select border-start-0 shadow-none">
                                    <option value="">-- Select Doctor --</option>
                                    @if (ViewBag.Doctors != null)
                                    {
                                        foreach (var doc in ViewBag.Doctors)
                                        {
                                            <option value="@doc.DoctorId">@doc.DoctorName (@doc.Specialization)</option>
                                        }
                                    }
                                </select>
                            </div>
                            <span asp-validation-for="DoctorId" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- أزرار الإجراءات -->
                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">Cancel</a>
                            <button type="submit" class="btn btn-warning text-dark rounded-pill px-4 fw-semibold shadow-sm">
                                <i class="bi bi-check-lg me-1"></i> Update Appointment
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}