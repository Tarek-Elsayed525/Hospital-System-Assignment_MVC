@model Hospital_System___Assignment.Models.BookAppointment

@{
    ViewData["Title"] = "Make Appointment";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-lg border-0 p-4 rounded-4 bg-white text-dark">
            <div class="card-body">
                <h3 class="text-center mb-4 fw-bold" style="color: #333;">
                    Make Appointment with Doctor @ViewBag.DoctorName
                </h3>

                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="DoctorId" />

                    <div class="mb-3">
                        <label asp-for="PatientName" class="form-label fw-semibold text-secondary">Patient Name</label>
                        <input asp-for="PatientName" class="form-control form-control-lg" placeholder="Your Name" required />
                        <span asp-validation-for="PatientName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AppointmentDate" class="form-label fw-semibold text-secondary">Appointment Date</label>
                        <input asp-for="AppointmentDate" type="date" class="form-control form-control-lg" min="@DateTime.Now.ToString("yyyy-MM-dd")" lang="en" dir="ltr" required />
                        <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="AppointmentTime" class="form-label fw-semibold text-secondary">Appointment Time</label>
                        <select asp-for="AppointmentTime" class="form-select form-control-lg" required>
                            <option value="">Select Appointment Time</option>
                            <option value="09:00 AM">09:00 AM</option>
                            <option value="09:30 AM">09:30 AM</option>
                            <option value="10:00 AM">10:00 AM</option>
                            <option value="10:30 AM">10:30 AM</option>
                            <option value="11:00 AM">11:00 AM</option>
                            <option value="11:30 AM">11:30 AM</option>
                            <option value="12:00 PM">12:00 PM</option>
                            <option value="12:30 PM">12:30 PM</option>
                            <option value="01:00 PM">01:00 PM</option>
                            <option value="01:30 PM">01:30 PM</option>
                            <option value="02:00 PM">02:00 PM</option>
                            <option value="02:30 PM">02:30 PM</option>
                            <option value="03:00 PM">03:00 PM</option>
                            <option value="03:30 PM">03:30 PM</option>
                            <option value="04:00 PM">04:00 PM</option>
                            <option value="04:30 PM">04:30 PM</option>
                            <option value="05:00 PM">05:00 PM</option>
                            <option value="05:30 PM">05:30 PM</option>
                            <option value="06:00 PM">06:00 PM</option>
                        </select>
                        <span asp-validation-for="AppointmentTime" class="text-danger"></span>
                    </div>

                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-success btn-lg px-5 py-2 fw-bold shadow-sm" style="background-color: #198754; border-color: #198754; border-radius: 6px;">
                            Save Appointment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>