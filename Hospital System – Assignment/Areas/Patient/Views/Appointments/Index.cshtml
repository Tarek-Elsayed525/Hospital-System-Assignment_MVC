@model IEnumerable<Hospital_System___Assignment.Models.BookAppointment>

@{
    ViewData["Title"] = "All Appointments";
}

<div class="container my-5">
    <div class="card shadow-lg border-0 p-4 rounded-4 bg-white text-dark">
        <div class="card-body">
            <h2 class="text-center mb-4 fw-bold text-dark">All Appointments</h2>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Specialization</th>
                            <th>Date</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.PatientName</td>
                                    <td>@(item.Doctor != null ? item.Doctor.DoctorName : "N/A")</td>
                                    <td>@(item.Doctor != null ? item.Doctor.Specialization : "N/A")</td>
                                    <td>@item.AppointmentDate.ToString("yyyy-MM-dd")</td>
                                    <td><span class="badge bg-success">@item.AppointmentTime</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-secondary">No appointments found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- أزرار الـ Pagination الاحترافية -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">

                        <!-- زر السابق (Previous) -->
                        <li class="page-item @(ViewBag.currentpage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.currentpage - 1)">Previous</a>
                        </li>

                        <!-- أرقام الصفحات -->
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(ViewBag.currentpage == i ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                            </li>
                        }

                        <!-- زر التالي (Next) -->
                        <li class="page-item @(ViewBag.currentpage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.currentpage + 1)">Next</a>
                        </li>

                    </ul>
                </nav>
            }

        </div>
    </div>
</div>